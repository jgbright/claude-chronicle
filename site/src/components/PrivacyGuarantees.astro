---
const guarantees = [
  {
    title: 'Local Processing Only',
    desc: 'Sessions are parsed and curated on your machine. Chronicle does not require cloud services or hosted accounts.',
  },
  {
    title: 'Read-Only Source Sessions',
    desc: 'Original JSONL files under ~/.claude/ are never modified. All edits are stored separately as Chronicle manifests.',
  },
  {
    title: 'Export Sanitization',
    desc: 'Exports remove deleted content and normalize home-directory paths so shared artifacts expose less local context.',
  },
];
---

<section id="privacy" class="privacy reveal">
  <div class="section-header">
    <p class="kicker">Privacy</p>
    <h2>Clear guarantees before you share anything</h2>
    <p>Chronicle is designed so curation and publishing can happen without sending your session data to external systems.</p>
  </div>

  <div class="guarantees-grid">
    {
      guarantees.map((item) => (
        <article class="guarantee-card">
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .privacy {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--section-padding);
  }

  .section-header {
    margin-bottom: 1.2rem;
    max-width: 72ch;
  }

  .kicker {
    color: var(--color-link);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .section-header h2 {
    font-size: clamp(1.5rem, 3.7vw, 2.1rem);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  .section-header p {
    color: var(--color-text-muted);
  }

  .guarantees-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.95rem;
  }

  .guarantee-card {
    background: linear-gradient(165deg, rgba(15, 111, 255, 0.07), rgba(255, 139, 61, 0.06)), var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: var(--shadow-soft);
    padding: 1rem;
    transition: transform 170ms ease, box-shadow 170ms ease;
  }

  .guarantee-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-strong);
  }

  .guarantee-card h3 {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }

  .guarantee-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 980px) {
    .guarantees-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
