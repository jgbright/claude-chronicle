---
const features = [
  {
    badge: 'SRCH',
    title: 'Session Discovery + Search',
    desc: 'Auto-discovers Claude Code sessions with project-level filtering and full-text search across conversation content.',
  },
  {
    badge: 'THEME',
    title: 'Dual Theme Rendering',
    desc: 'Claude and Copilot presentation modes with markdown, syntax-highlighted code blocks, and thought annotation support.',
  },
  {
    badge: 'EDIT',
    title: 'Safe Non-Destructive Editing',
    desc: 'Trim, collapse, annotate, and reorder blocks in a workspace layer. Source JSONL files are never mutated.',
  },
  {
    badge: 'HTML',
    title: 'Portable Single-File Export',
    desc: 'Generate one standalone HTML file with inlined assets so you can archive or share without extra hosting setup.',
  },
  {
    badge: 'PRIV',
    title: 'Privacy-First by Default',
    desc: 'Everything runs locally with optional PII sanitization prior to export. No account, no telemetry, no cloud required.',
  },
  {
    badge: 'GO',
    title: 'Single Binary Delivery',
    desc: 'Go backend + embedded React app shipped as one executable for simple installation and predictable environments.',
  },
];
---

<section id="features" class="features reveal">
  <div class="section-header">
    <p class="kicker">Capabilities</p>
    <h2>Built for fast curation without data risk</h2>
  </div>

  <div class="feature-grid">
    {
      features.map((f) => (
        <article class="feature-card">
          <p class="badge" aria-hidden="true">{f.badge}</p>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .features {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--section-padding);
  }

  .section-header {
    margin-bottom: 1.2rem;
  }

  .kicker {
    color: var(--color-link);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .section-header h2 {
    font-size: clamp(1.5rem, 3.7vw, 2.1rem);
    line-height: 1.15;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .feature-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1rem;
    box-shadow: var(--shadow-soft);
  }

  .badge {
    width: fit-content;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border-strong);
    color: var(--color-link);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
    margin-bottom: 0.55rem;
  }

  .feature-card h3 {
    font-size: 1rem;
    line-height: 1.25;
    margin-bottom: 0.4rem;
  }

  .feature-card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 980px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>