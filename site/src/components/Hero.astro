---
const base = import.meta.env.BASE_URL;
---

<section class="hero reveal">
  <div class="hero-grid">
    <div>
      <p class="eyebrow">Local-first session publishing</p>
      <h1>Turn raw Claude sessions into polished shareable artifacts</h1>
      <p class="tagline">
        Browse, clean, and export conversations from your machine into one
        self-contained HTML page. No cloud, no accounts, no lock-in.
      </p>
      <div class="hero-buttons">
        <a href={`${base}demo/`} class="btn btn-primary">Open Live Demo</a>
        <a
          href="https://github.com/jgbright/claude-chronicle/releases/latest"
          class="btn btn-secondary">Download Latest</a
        >
        <a
          href="https://github.com/jgbright/claude-chronicle"
          class="btn btn-secondary">GitHub</a
        >
      </div>
      <div class="hero-metrics" aria-label="Project highlights">
        <p><strong>Local-first</strong> runtime</p>
        <p><strong>Single-file</strong> export</p>
        <p><strong>Zero cloud</strong> requirement</p>
      </div>
    </div>
    <aside class="hero-card" aria-label="CLI example">
      <p class="card-title">From terminal to export</p>
      <pre><span class="comment"># launch local UI</span>
<span class="cmd">claude-chronicle serve</span>

<span class="comment"># export one session</span>
<span class="cmd">claude-chronicle export -session &lt;id&gt; -o session.html</span></pre>
      <p class="meta">Single Go binary. React UI embedded. Static HTML output.</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4.75rem 1.5rem 2.6rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.9fr;
    gap: 2rem;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border-strong);
    color: var(--color-link);
    border-radius: 999px;
    padding: 0.25rem 0.68rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.85rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.85rem;
    max-width: 18ch;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 1.4rem;
    max-width: 60ch;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 0.95rem;
  }

  .hero-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-metrics p {
    font-size: 0.78rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    color: var(--color-text-faint);
  }

  .hero-metrics strong {
    color: var(--color-text);
  }

  .hero-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.1rem 1rem 1rem;
    box-shadow: var(--shadow-soft);
    position: relative;
    overflow: hidden;
  }

  .hero-card::before {
    content: '';
    position: absolute;
    inset: -35% auto auto -10%;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(255, 139, 61, 0.18), transparent 70%);
    pointer-events: none;
  }

  .card-title {
    font-size: 0.88rem;
    color: var(--color-text-faint);
    margin-bottom: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  pre {
    font-family: var(--font-mono);
    background: #0f1728;
    color: #e4eaf7;
    border-radius: 12px;
    font-size: 0.82rem;
    padding: 0.9rem;
    line-height: 1.7;
    overflow-x: auto;
    margin-bottom: 0.75rem;
  }

  .comment {
    color: #93a6cc;
  }

  .cmd {
    color: #8ecbff;
  }

  .meta {
    color: var(--color-text-faint);
    font-size: 0.85rem;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 3.2rem 1.15rem 1.8rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .hero h1 {
      max-width: none;
    }
  }

  @media (max-width: 520px) {
    .hero-buttons .btn {
      width: 100%;
    }
  }
</style>
