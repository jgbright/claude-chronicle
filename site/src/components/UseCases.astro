---
const useCases = [
  {
    title: 'Team Handoffs',
    desc: 'Package a complex debugging or implementation session so the next engineer can get context in minutes.',
  },
  {
    title: 'Incident Timelines',
    desc: 'Curate investigation threads into a clean narrative for postmortems and operational review.',
  },
  {
    title: 'Portfolio Artifacts',
    desc: 'Turn raw AI-assisted build logs into polished writeups that show decision-making and execution.',
  },
  {
    title: 'Audit Trails',
    desc: 'Preserve an editable but non-destructive record of technical reasoning for compliance and governance.',
  },
];
---

<section id="use-cases" class="use-cases reveal">
  <div class="section-header">
    <p class="kicker">Use Cases</p>
    <h2>Where Chronicle delivers the most value</h2>
    <p>Designed for teams and individuals who need to transform AI session history into readable, reusable documentation.</p>
  </div>

  <div class="use-cases-grid">
    {
      useCases.map((item) => (
        <article class="use-case-card">
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .use-cases {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--section-padding);
  }

  .section-header {
    margin-bottom: 1.2rem;
    max-width: 72ch;
  }

  .kicker {
    color: var(--color-link);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .section-header h2 {
    font-size: clamp(1.5rem, 3.7vw, 2.1rem);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  .section-header p {
    color: var(--color-text-muted);
  }

  .use-cases-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.95rem;
  }

  .use-case-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: var(--shadow-soft);
    padding: 1rem;
    transition: transform 170ms ease, box-shadow 170ms ease;
  }

  .use-case-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-strong);
  }

  .use-case-card h3 {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }

  .use-case-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 780px) {
    .use-cases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
