---
const sha = import.meta.env.GITHUB_SHA || 'local';
const shortSha = sha.substring(0, 7);
const buildDate = new Date().toISOString().split('T')[0];
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <nav class="footer-links" aria-label="Footer links">
    <a href="https://github.com/jgbright/claude-chronicle">GitHub</a>
    <a href="https://github.com/jgbright/claude-chronicle/releases/latest">Releases</a>
    <a href={`${base}component-gallery/`}>Component Gallery</a>
    <a href={`${base}storybook/`}>Storybook</a>
    <a href="https://codecov.io/gh/jgbright/claude-chronicle">Coverage</a>
  </nav>
  <p>MIT License</p>
  <p>Commit <code>{shortSha}</code> - Built {buildDate}</p>
</footer>

<style>
  .site-footer {
    max-width: var(--max-width);
    margin: 2rem auto 0;
    padding: 2.4rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
    margin-bottom: 0.75rem;
  }

  .footer-links a {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .site-footer p {
    font-size: 0.84rem;
    color: var(--color-text-faint);
  }

  .site-footer p + p {
    margin-top: 0.35rem;
  }
</style>