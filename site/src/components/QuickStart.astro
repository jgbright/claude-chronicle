---
const platforms = [
  {
    id: 'linux',
    label: 'Linux',
    title: 'Linux (amd64)',
    install: 'curl -fL https://github.com/jgbright/claude-chronicle/releases/latest/download/claude-chronicle_linux_amd64.tar.gz | tar xz',
    run: './claude-chronicle serve',
  },
  {
    id: 'macos',
    label: 'macOS',
    title: 'macOS (arm64)',
    install: 'curl -fL https://github.com/jgbright/claude-chronicle/releases/latest/download/claude-chronicle_darwin_arm64.tar.gz | tar xz',
    run: './claude-chronicle serve',
  },
  {
    id: 'windows',
    label: 'Windows',
    title: 'Windows (PowerShell)',
    install: 'curl.exe -fL https://github.com/jgbright/claude-chronicle/releases/latest/download/claude-chronicle_windows_amd64.zip | tar -x -f -',
    run: '.\\claude-chronicle.exe serve',
  },
];
---

<section id="quickstart" class="quickstart reveal">
  <div class="section-header">
    <p class="kicker">Quick Start</p>
    <h2>Install in minutes on Linux, macOS, or Windows</h2>
    <p>Choose your platform and copy the command. You only need one path.</p>
  </div>

  <div class="quickstart-shell">
    <div class="platform-tabs" role="tablist" aria-label="Operating systems">
      {
        platforms.map((platform, index) => (
          <button
            class="tab-btn"
            type="button"
            role="tab"
            id={`tab-${platform.id}`}
            data-tab={platform.id}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`panel-${platform.id}`}
            tabindex={index === 0 ? '0' : '-1'}
          >
            {platform.label}
          </button>
        ))
      }
    </div>

    {
      platforms.map((platform, index) => (
        <article
          class="platform-panel"
          role="tabpanel"
          id={`panel-${platform.id}`}
          aria-labelledby={`tab-${platform.id}`}
          data-panel={platform.id}
          hidden={index !== 0}
        >
          <h3>{platform.title}</h3>
          <div class="code-section">
            <p class="code-label">Install</p>
            <div class="code-wrap">
              <pre><code id={`install-${platform.id}`}>{platform.install}</code></pre>
              <button class="copy-btn" type="button" data-copy={`install-${platform.id}`}>Copy</button>
            </div>
          </div>
          <div class="code-section">
            <p class="code-label">Run</p>
            <div class="code-wrap">
              <pre><code id={`run-${platform.id}`}>{platform.run}</code></pre>
              <button class="copy-btn" type="button" data-copy={`run-${platform.id}`}>Copy</button>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="next-step">
    <p>Export your first curated session:</p>
    <div class="code-inline">
      <code>claude-chronicle export -session &lt;id&gt; -o session.html</code>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll('.tab-btn'));
  const panels = Array.from(document.querySelectorAll('.platform-panel'));

  function activateTab(id) {
    tabs.forEach((tab) => {
      const selected = tab.dataset.tab === id;
      tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      tab.setAttribute('tabindex', selected ? '0' : '-1');
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== id;
    });
  }

  function detectPlatform() {
    const ua = navigator.userAgent.toLowerCase();
    if (ua.includes('win')) return 'windows';
    if (ua.includes('mac')) return 'macos';
    return 'linux';
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activateTab(tab.dataset.tab || 'linux'));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const currentIndex = tabs.findIndex((item) => item === tab);
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const nextIndex = (currentIndex + direction + tabs.length) % tabs.length;
      const nextTab = tabs[nextIndex];
      activateTab(nextTab.dataset.tab || 'linux');
      nextTab.focus();
    });
  });

  activateTab(detectPlatform());

  document.querySelectorAll('.copy-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.getAttribute('data-copy');
      if (!targetId) return;
      const target = document.getElementById(targetId);
      const value = target?.textContent?.trim();
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const original = button.textContent;
        button.textContent = 'Copied';
        setTimeout(() => {
          button.textContent = original;
        }, 1200);
      } catch {
        button.textContent = 'Failed';
        setTimeout(() => {
          button.textContent = 'Copy';
        }, 1200);
      }
    });
  });
</script>

<style>
  .quickstart {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--section-padding);
  }

  .section-header {
    margin-bottom: 1.2rem;
    max-width: 70ch;
  }

  .kicker {
    color: var(--color-link);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .section-header h2 {
    font-size: clamp(1.5rem, 3.7vw, 2.1rem);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  .section-header p {
    color: var(--color-text-muted);
  }

  .quickstart-shell {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: var(--shadow-soft);
    padding: 1rem;
  }

  .platform-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.28rem;
    margin-bottom: 0.95rem;
  }

  .tab-btn {
    border: 0;
    background: transparent;
    border-radius: 999px;
    padding: 0.42rem 0.8rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .tab-btn[aria-selected='true'] {
    background: #fff;
    color: var(--color-text);
    box-shadow: 0 4px 12px rgba(15, 40, 80, 0.12);
  }

  .platform-panel h3 {
    font-size: 1rem;
    margin-bottom: 0.8rem;
  }

  .code-section + .code-section {
    margin-top: 0.65rem;
  }

  .code-label {
    color: var(--color-text-faint);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    margin-bottom: 0.38rem;
  }

  .code-wrap {
    background: #0f1728;
    border: 1px solid #1f2e4f;
    border-radius: 12px;
    padding: 0.78rem;
    position: relative;
    overflow-x: auto;
  }

  pre {
    margin: 0;
  }

  code {
    background: transparent;
    border: 0;
    color: #deebff;
    padding: 0;
    white-space: pre;
    font-size: 0.79rem;
    line-height: 1.55;
    font-family: var(--font-mono);
  }

  .copy-btn {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    border: 1px solid #315080;
    background: #16253f;
    color: #cfe0ff;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.73rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
  }

  .copy-btn:hover {
    background: #1f3254;
  }

  .next-step {
    margin-top: 1rem;
    background: var(--color-surface-soft);
    border: 1px dashed var(--color-border-strong);
    border-radius: 12px;
    padding: 0.8rem 0.95rem;
  }

  .next-step p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.45rem;
  }

  .code-inline code {
    display: inline-block;
    word-break: break-word;
  }

  @media (max-width: 640px) {
    .quickstart-shell {
      padding: 0.8rem;
    }

    .platform-tabs {
      width: 100%;
      justify-content: space-between;
      border-radius: 12px;
    }

    .tab-btn {
      flex: 1 1 30%;
      text-align: center;
      border-radius: 9px;
      padding: 0.44rem 0.55rem;
    }
  }
</style>
